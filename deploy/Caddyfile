# Cloudflare proxies in front (SSL mode Full (strict)). Caddy gets Let's Encrypt certs over DNS-01 with the
# Cloudflare token (CF_API_TOKEN, Zone.DNS edit on this zone). A local test (DOMAIN=localhost) uses Caddy's own CA.
{
	acme_dns cloudflare {env.CF_API_TOKEN}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy api:8612
	}
	handle {
		root * /srv/site
		file_server
	}
	handle_errors 404 {
		root * /srv/site
		rewrite * /404.html
		file_server
	}
}
