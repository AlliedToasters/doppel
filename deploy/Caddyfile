# Cloudflare proxies in front (SSL mode Full (strict)). Caddy gets Let's Encrypt certs over DNS-01 with the
# Cloudflare token (CF_API_TOKEN, Zone.DNS edit on this zone). A local test (DOMAIN=localhost) uses Caddy's own CA.
# Client IPs: only Cloudflare's edge reaches us through the proxy, so trust CF-Connecting-IP from Cloudflare's
# ranges and nobody else. Caddy then logs the visitor and passes them on in X-Forwarded-For. A request from any
# other address keeps its own IP, so the header can't be spoofed by hitting the origin directly. Ranges from
# https://www.cloudflare.com/ips/ (checked 2026-11-08); they change rarely.
{
	acme_dns cloudflare {env.CF_API_TOKEN}
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
		trusted_proxies_strict
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy api:8612
	}
	handle {
		root * /srv/site
		file_server
	}
	handle_errors 404 {
		root * /srv/site
		rewrite * /404.html
		file_server
	}
}
